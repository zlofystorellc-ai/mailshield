# ---------------- MailShield server configuration ----------------
# Copy to .env (repo root, used by docker-compose) or server/.env. Never commit real values.

NODE_ENV=development
PORT=3000

# MongoDB (Atlas in production: mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/mailshield)
MONGODB_URI=mongodb://localhost:27017/mailshield

# Long random strings: `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_SECRET=change-me-too-at-least-16-chars

# Your published extension origin(s), comma-separated: chrome-extension://<extension-id>
# (In development any chrome-extension:// origin is accepted.)
EXTENSION_ORIGIN=

# ---- Threat-intel APIs (all optional; missing keys just skip that check) ----
SAFE_BROWSING_KEY=
VIRUSTOTAL_KEY=
URLHAUS_KEY=

# ---- Embeddings for report clustering ----
# local  = built-in hashed bag-of-concepts (no network, 256 dims)
# openai = OpenAI embeddings (set EMBEDDING_API_KEY; text-embedding-3-small -> 1536 dims)
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=256

# ---- Optional LLM (classification of uncertain emails for opted-in users + cluster summaries) ----
# none | anthropic | openai
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Use MongoDB Atlas $vectorSearch (requires the indexes in server/atlas/). false = SimHash + keywords only.
ATLAS_VECTOR_SEARCH=false

# ---- Learning thresholds ----
# distinct (trusted) users before a cluster becomes a pending_review signature
REPORT_THRESHOLD=3
# distinct users before a signature auto-activates for everyone
AUTO_ACTIVATE_THRESHOLD=10
SIMHASH_DISTANCE=6
COSINE_THRESHOLD=0.85
MIN_REPORTER_TRUST=0.3
REPORTS_PER_DAY=20
# false alarms needed (and ratio vs. distinct reporters) to send an active signature back to review
FALSE_ALARM_MIN=3
FALSE_ALARM_RATIO=0.3

# Run the report-analysis worker inside the API process (set false if you run `npm run worker` separately)
RUN_WORKER=true
