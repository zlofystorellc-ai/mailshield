{
  "manifest_version": 3,
  "name": "MailShield – Gmail Scam & Phishing Protection",
  "short_name": "MailShield",
  "version": "1.0.0",
  "description": "Warns you about phishing, UPI/bank fraud, OTP scams and malicious links in Gmail. English + Hinglish.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "activeTab", "alarms"],
  "host_permissions": [
    "https://mail.google.com/*",
    "http://localhost:3000/*",
    "https://api.mailshield.example.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": [
        "lib/brands.js",
        "lib/redact.js",
        "lib/normalize.js",
        "lib/simhash.js",
        "lib/harms.js",
        "lib/signatures.js",
        "lib/heuristics.js",
        "lib/i18n.js",
        "content/selectors.js",
        "content/extract.js",
        "content/ui.js",
        "content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "MailShield",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
